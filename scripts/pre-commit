#!/usr/bin/env bash
# GameRoomLog Git Pre-Commit Hook
# Impede o commit caso algum teste automatizado (backend ou frontend) falhe.

echo "🔍 Executando suíte de testes automatizados do GameRoomLog..."

# Detecta se o ambiente virtual existe
if [ -f "./venv/bin/pytest" ]; then
    PYTEST_BIN="./venv/bin/pytest"
else
    PYTEST_BIN="pytest"
fi

# Executa todos os testes
$PYTEST_BIN
STATUS=$?

if [ $STATUS -ne 0 ]; then
    echo "❌ COMMIT BLOQUEADO: Os testes automatizados falharam!"
    echo "💡 Corrija as falhas acima antes de realizar o commit."
    exit 1
fi

echo "✅ Todos os testes passaram com sucesso! Prosseguindo com o commit."
exit 0
