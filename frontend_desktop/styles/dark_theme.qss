/* GameRoomLog Dark Theme v0.0.3 - Alto Contraste & Bordas Nítidas */

/* Fundo Geral */
QMainWindow, QWidget#centralWidget {
    background-color: #0d0e12;
    color: #f3f4f6;
    font-family: "Segoe UI", "Inter", "Noto Sans", sans-serif;
    font-size: 13px;
}

/* Sidebar */
QWidget#sidebarWidget {
    background-color: #13141b;
    border-right: 1px solid #232532;
}

QLabel#appTitle {
    font-size: 18px;
    font-weight: 800;
    color: #ffffff;
    padding: 4px 0;
}

QLabel#appSubtitle {
    font-size: 11px;
    color: #9ca3af;
    margin-bottom: 6px;
}

/* Botões da Sidebar */
QPushButton.nav-btn {
    background-color: #1a1c26;
    color: #cbd5e1;
    text-align: left;
    padding: 8px 12px;
    border: 1px solid #282a3a;
    border-radius: 7px;
    font-size: 12px;
    font-weight: 500;
    margin-bottom: 2px;
}

QPushButton.nav-btn:hover {
    background-color: #262938;
    color: #ffffff;
    border: 1px solid #4f5673;
}

QPushButton.nav-btn:checked {
    background-color: #7f5af028;
    color: #a78bfa;
    font-weight: bold;
    border: 1px solid #7f5af0;
    border-left: 4px solid #7f5af0;
}

/* Botão Principal (+ Adicionar Jogo) */
QPushButton#btnAddGame {
    background-color: #7f5af0;
    color: #ffffff;
    border: 1px solid #906ffa;
    border-radius: 8px;
    padding: 9px 14px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#btnAddGame:hover {
    background-color: #6d44eb;
    border: 1px solid #b39bfb;
}

QPushButton#btnAddGame:pressed {
    background-color: #582cd1;
}

/* Formulários, Diálogos e Caixas de Entrada */
QDialog {
    background-color: #13141b;
    color: #f3f4f6;
}

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTextEdit {
    background-color: #1c1e2a;
    color: #ffffff;
    border: 1.5px solid #363b4f;
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
    min-height: 18px;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QTextEdit:focus {
    border: 1.5px solid #7f5af0;
    background-color: #232635;
}

QComboBox QAbstractItemView {
    background-color: #1c1e2a;
    color: #ffffff;
    border: 1px solid #363b4f;
    selection-background-color: #7f5af0;
    selection-color: #ffffff;
    padding: 4px;
}

QComboBox::drop-down {
    border: none;
    padding-right: 8px;
}

/* Labels de Formulário */
QLabel.form-label {
    color: #94a3b8;
    font-weight: 600;
    font-size: 12px;
}

/* Cards de Jogo */
QFrame.game-card {
    background-color: #161822;
    border: 1.5px solid #2a2e40;
    border-radius: 10px;
}

QFrame.game-card:hover {
    border: 1.5px solid #7f5af0;
    background-color: #1d202d;
}

QLabel.card-title {
    font-size: 13px;
    font-weight: bold;
    color: #ffffff;
}

QLabel.card-meta {
    font-size: 11px;
    color: #9ca3af;
}

/* Cards de Estatísticas e Gerenciamento */
QFrame.stat-card, QFrame.manage-card {
    background-color: #161822;
    border: 1.5px solid #2a2e40;
    border-radius: 10px;
    padding: 12px;
}

QFrame.manage-card:hover {
    border: 1.5px solid #7f5af0;
    background-color: #1d202d;
}

QLabel.stat-value {
    font-size: 22px;
    font-weight: 800;
    color: #2cb67d;
}

QLabel.stat-label {
    font-size: 11px;
    font-weight: 600;
    color: #9ca3af;
    text-transform: uppercase;
}

/* Botões Genéricos */
QPushButton.action-btn {
    background-color: #2cb67d;
    color: #0d0e12;
    font-weight: bold;
    border: 1px solid #3dd695;
    border-radius: 6px;
    padding: 8px 16px;
}

QPushButton.action-btn:hover {
    background-color: #25a26e;
}

QPushButton.cancel-btn {
    background-color: #232635;
    color: #e2e8f0;
    border: 1.5px solid #363b4f;
    border-radius: 6px;
    padding: 8px 16px;
}

QPushButton.cancel-btn:hover {
    background-color: #2d3144;
    border: 1.5px solid #4f5673;
}

QPushButton.small-btn {
    background-color: #1f222e;
    color: #e2e8f0;
    border: 1.5px solid #363b4f;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 11px;
}

QPushButton.small-btn:hover {
    background-color: #292d3e;
    border: 1.5px solid #7f5af0;
    color: #ffffff;
}

QPushButton.delete-btn {
    background-color: #e53e3e22;
    color: #fc8181;
    border: 1.5px solid #e53e3e66;
    border-radius: 5px;
    padding: 5px 10px;
    font-size: 11px;
}

QPushButton.delete-btn:hover {
    background-color: #e53e3e;
    color: #ffffff;
}

/* Tabela */
QTableWidget {
    background-color: #13141b;
    alternate-background-color: #181a23;
    gridline-color: #252838;
    color: #f3f4f6;
    border: 1.5px solid #2a2e40;
    border-radius: 8px;
    selection-background-color: #7f5af055;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #1a1c26;
    color: #cbd5e1;
    font-weight: bold;
    font-size: 12px;
    padding: 9px;
    border: none;
    border-bottom: 2px solid #2a2e40;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #101117;
    width: 8px;
}

QScrollBar:vertical:horizontal {
    height: 8px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #363b4f;
    min-height: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #7f5af0;
}
