/* GameRoomLog Dark Theme - Fusion Base & Modern High Contrast */

/* Janela Principal e Fundo */
QMainWindow, QWidget#centralWidget {
    background-color: #0d0e14;
    color: #f1f5f9;
    font-family: "Segoe UI", "Inter", "Noto Sans", sans-serif;
    font-size: 13px;
}

/* ========================================================================= */
/* SCROLL AREAS E PAINÉIS GERAIS                                             */
/* ========================================================================= */

QWidget#contentArea {
    background-color: #0d0e14;
    padding: 10px;
}

QWidget[class="game-grid-container"] {
    background-color: #161824; /* Exemplo: fundo para a grade de jogos */
    border: 1px solid #232738; /* Exemplo: borda ao redor dos cards */
    border-radius: 10px;
    padding: 12px;             /* Espaço interno entre os cards e a borda */
}

QWidget#gameRoomScrollContainer {
    background-color: #12141d; /* Exemplo: fundo para toda a área rolavel */
    border: 1px solid #232738; /* Exemplo: borda externa contornando as duas seções juntas */
    border-radius: 12px;
    padding: 16px;             /* Espaço interno para afastar os blocos da borda */
}

QFrame[class="game-section-card"] {
    background-color: #12141d;
    border-radius: 10px;
    padding: 14px;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QWidget#scrollAreaWidgetContents {
    background-color: transparent;
}

/* ========================================================================= */
/* SIDEBAR                                                                   */
/* ========================================================================= */

QWidget#sidebarWidget {
    background-color: #12141d;
    border-right: 1px solid #232738;
}

QLabel#appTitle {
    font-size: 18px;
    font-weight: 800;
    color: #ffffff;
    padding: 4px 0;
}

QLabel#appSubtitle {
    font-size: 11px;
    color: #94a3b8;
    margin-bottom: 6px;
}

QWidget#sidebarNavContainer {
    border: none;
    border-radius: 8px;
    padding: 10px;
}

/* Botões da Barra Lateral */
QPushButton[class="nav-btn"] {
    background-color: #181b28;
    color: #cbd5e1;
    text-align: left;
    padding: 8px 12px;
    border: 1px solid #262b3f;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    margin: 3px 3px;
}

QPushButton[class="nav-btn"]:hover {
    background-color: #252a3f;
    color: #ffffff;
    border: 1px solid #5a6488;
}

QPushButton[class="nav-btn"]:checked {
    background-color: #7f5af033;
    color: #a78bfa;
    font-weight: bold;
    border: 1px solid #7f5af0;
    border-left: 4px solid #7f5af0;
}

QPushButton#btnAddGame {
    background-color: #7f5af0;
    color: #ffffff;
    border: 1px solid #906ffa;
    border-radius: 7px;
    padding: 9px 14px;
    font-weight: bold;
    font-size: 13px;
}

QPushButton#btnAddGame:hover {
    background-color: #6d44eb;
    border: 1px solid #c4b5fd;
}

QPushButton#btnAddGame:pressed {
    background-color: #582cd1;
}

/* ========================================================================= */
/* DIALOGS, MODAIS & FORMULÁRIOS (INPUTS, COMBOS, SPINS, BOTÕES)            */
/* ========================================================================= */

QDialog {
    background-color: #12141d;
    color: #f1f5f9;
}

/* Todos os campos de entrada */
QLineEdit, 
QComboBox, 
QSpinBox, 
QDoubleSpinBox, 
QDateEdit, 
QTextEdit {
    background-color: #1c2030;
    color: #ffffff;
    border: 1px solid #3c435f;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 13px;
    min-height: 20px;
    selection-background-color: #7f5af0;
    selection-color: #ffffff;
}

/* Efeito Hover nos Campos */
QLineEdit:hover, 
QComboBox:hover, 
QSpinBox:hover, 
QDoubleSpinBox:hover, 
QDateEdit:hover, 
QTextEdit:hover {
    border: 1px solid #6366f1;
    background-color: #22273b;
}

/* Efeito Focus (Campo Ativo / Clicado) */
QLineEdit:focus, 
QComboBox:focus, 
QSpinBox:focus, 
QDoubleSpinBox:focus, 
QDateEdit:focus, 
QTextEdit:focus {
    border: 1px solid #7f5af0;
    background-color: #262c42;
}

/* QComboBox popup e lista */
QComboBox QAbstractItemView {
    background-color: #181b28;
    color: #ffffff;
    border: 1px solid #3c435f;
    border-radius: 6px;
    selection-background-color: #7f5af0;
    selection-color: #ffffff;
    padding: 4px;
    outline: 0px;
}

/* QComboBox Seta */
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 26px;
    border-left: 1px solid #3c435f;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background-color: #24293e;
}

QComboBox::drop-down:hover {
    background-color: #384061;
}

/* Botões do Formulário */
QPushButton[class="action-btn"] {
    background-color: #2cb67d;
    color: #0d0e14;
    font-weight: bold;
    border: 1px solid #3dd695;
    border-radius: 6px;
    padding: 8px 18px;
    font-size: 13px;
}

QPushButton[class="action-btn"]:hover {
    background-color: #28a772;
    border: 1px solid #5cfbb9;
}

QPushButton[class="cancel-btn"] {
    background-color: #202436;
    color: #e2e8f0;
    border: 1px solid #3c435f;
    border-radius: 6px;
    padding: 8px 18px;
    font-size: 13px;
}

QPushButton[class="cancel-btn"]:hover {
    background-color: #2b3149;
    border: 1px solid #6366f1;
    color: #ffffff;
}

QPushButton[class="small-btn"] {
    background-color: #202436;
    color: #e2e8f0;
    border: 1px solid #3c435f;
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 500;
}

QPushButton[class="small-btn"]:hover {
    background-color: #2b3149;
    border: 1px solid #7f5af0;
    color: #ffffff;
}

QPushButton[class="delete-btn"] {
    background-color: #e53e3e26;
    color: #fc8181;
    border: 1px solid #e53e3e77;
    border-radius: 6px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: bold;
}

QPushButton[class="delete-btn"]:hover {
    background-color: #e53e3e;
    color: #ffffff;
    border: 1px solid #fc8181;
}

/* Labels de Formulário */
QLabel[class="form-label"] {
    color: #94a3b8;
    font-weight: 700;
    font-size: 13px;
}

/* CheckBoxes */
QCheckBox {
    color: #e2e8f0;
    font-size: 12px;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #3c435f;
    border-radius: 4px;
    background-color: #1c2030;
}

QCheckBox::indicator:hover {
    border: 1px solid #7f5af0;
}

QCheckBox::indicator:checked {
    background-color: #7f5af0;
    border: 1px solid #906ffa;
}

/* ========================================================================= */
/* CARDS E GRIDS                                                             */
/* ========================================================================= */

QFrame[class="game-card"] {
    background-color: #161824;
    border: 1px solid #282c3f;
    border-radius: 10px;
}

QFrame[class="game-card"]:hover {
    border: 1px solid #7f5af0;
    background-color: #1c2030;
}

QLabel[class="card-title"] {
    font-size: 13px;
    font-weight: bold;
    color: #ffffff;
}

QLabel[class="card-meta"] {
    font-size: 11px;
    color: #94a3b8;
}

QFrame[class="stat-card"], QFrame[class="manage-card"] {
    background-color: #161824;
    border: 1px solid #282c3f;
    border-radius: 10px;
    padding: 12px;
}

QFrame[class="manage-card"]:hover {
    border: 1px solid #7f5af0;
    background-color: #1c2030;
}

QLabel[class="stat-value"] {
    font-size: 22px;
    font-weight: 800;
    color: #2cb67d;
}

QLabel[class="stat-label"] {
    font-size: 11px;
    font-weight: 600;
    color: #94a3b8;
    text-transform: uppercase;
}

/* ========================================================================= */
/* TABELA                                                                    */
/* ========================================================================= */

QTableWidget {
    background-color: #12141d;
    alternate-background-color: #161925;
    gridline-color: #232738;
    color: #f1f5f9;
    border: 1px solid #282c3f;
    border-radius: 8px;
    selection-background-color: #7f5af055;
    selection-color: #ffffff;
}

QHeaderView::section {
    background-color: #181b28;
    color: #cbd5e1;
    font-weight: bold;
    font-size: 12px;
    padding: 9px;
    border: none;
    border-bottom: 2px solid #282c3f;
}

/* Scrollbars */
QScrollBar:vertical {
    border: none;
    background: #0d0e14;
    width: 8px;
}

QScrollBar:horizontal {
    border: none;
    background: #0d0e14;
    height: 8px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #363b4f;
    min-height: 20px;
    min-width: 20px;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #7f5af0;
}

/* ========================================================================= */
/* TEXTOS, TÍTULOS E HEADERS (EXTRAÍDOS DO PYTHON)                           */
/* ========================================================================= */

QLabel#viewTitle {
    font-size: 20px;
    font-weight: 800;
    color: #ffffff;
}

QLabel[class="view-title-large"] {
    font-size: 22px;
    font-weight: 800;
    color: #ffffff;
}

QLabel[class="view-title-xl"] {
    font-size: 24px;
    font-weight: 800;
    color: #ffffff;
}

QLabel[class="section-header"] {
    font-size: 17px;
    font-weight: bold;
    color: #fffffe;
}

QLabel[class="section-header-small"] {
    font-size: 15px;
    font-weight: bold;
    color: #ffffff;
    margin-top: 8px;
}

QFrame[class="divider-line"] {
    background-color: #23232a;
    max-height: 1px;
}

QLabel[class="empty-state-text"] {
    color: #72757e;
    font-size: 14px;
    padding: 20px;
}

QLabel#appVersion {
    color: #6b7280;
    font-size: 10px;
    text-align: center;
    padding-top: 4px;
}

/* ========================================================================= */
/* CARDS DE GERENCIAMENTO (PLATAFORMAS, GÊNEROS) E SETTINGS                  */
/* ========================================================================= */

QLabel[class="manage-card-title"] {
    font-size: 15px;
    font-weight: bold;
    color: #ffffff;
}

QLabel[class="manage-card-count"] {
    color: #9ca3af;
    font-size: 11px;
}

QGroupBox[class="settings-group"] {
    font-weight: bold;
    color: #a5b4fc;
    font-size: 14px;
    margin-top: 10px;
    padding-top: 15px;
}

QLabel[class="settings-desc"] {
    color: #9ca3af;
    font-size: 12px;
    line-height: 1.6;
}

/* ========================================================================= */
/* ANUÁRIO (YEARBOOK)                                                        */
/* ========================================================================= */

QLabel[class="yearbook-icon"] {
    font-size: 20px;
}

QLabel[class="yearbook-title"] {
    font-size: 20px;
    font-weight: bold;
    color: #fffffe;
}

QLabel[class="yearbook-year"] {
    color: #94a1b2;
    font-weight: bold;
}

QLabel[class="yearbook-subtitle"] {
    font-size: 15px;
    font-weight: bold;
    color: #fffffe;
    margin-top: 10px;
}
